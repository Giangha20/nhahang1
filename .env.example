# Set NODE_ENV=production on your internet hosting platform
NODE_ENV=production
PORT=3000
# Use long, random values. Never commit your real .env file.
SESSION_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
BOOTSTRAP_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# On hosts with persistent disks, point this path at the mounted disk.
DB_PATH=./data/restaurant.sqlite
